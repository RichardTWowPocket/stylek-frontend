# Next.js Public Environment Variables (accessible in browser)
NEXT_PUBLIC_API_BASE_URL=https://staging.stylek-backend.richardtandean.my.id/api

# NextAuth Configuration
NEXTAUTH_URL=https://staging.stylek-frontend.richardtandean.my.id
NEXTAUTH_SECRET=your-nextauth-secret-key-minimum-32-characters-long-change-this-in-production

# Google OAuth (Required for Google login)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
